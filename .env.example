# Copy this file to `.env` to override the defaults. `.env` is git-ignored.
# The defaults are Sauce Demo's public demo values, so the suite runs with no setup.

BASE_URL=https://www.saucedemo.com
STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user
USER_PASSWORD=secret_sauce

# API tests target Restful-booker, a public practice API. These are its published demo values.
API_BASE_URL=https://restful-booker.herokuapp.com
API_USERNAME=admin
API_PASSWORD=password123
